<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Hanjin NL waybill</title>
    <style>
        @page { margin: 0; }
        * { box-sizing: border-box; }
        body { margin: 0; padding: 0; font-family: nanumgothic, sans-serif; color: #000; }
        table { border-collapse: collapse; }
        .label { width: 101.5mm; height: 100mm; overflow: hidden; border: 0.25mm solid #000; }
        .main { width: 100%; table-layout: fixed; }
        .main td { padding: 0.5mm 1mm; border-bottom: 0.25mm solid #000; vertical-align: middle; }
        .header { font-size: 7pt; font-weight: bold; }
        .route { width: 100%; table-layout: fixed; }
        .route td { padding: 0.25mm; border: 0; vertical-align: middle; }
        .hub { width: 19mm; text-align: center; font-size: 11pt; font-weight: bold; }
        .sort { font-size: 18pt; font-weight: bold; }
        .sub { font-size: 9pt; font-weight: bold; }
        .terminal-barcode { width: 22mm; height: 7mm; }
        .person { font-size: 12pt; font-weight: bold; }
        .address { font-size: 8pt; line-height: 1.1; }
        .small { font-size: 6.5pt; }
        .item-name { font-size: 11pt; font-weight: bold; }
        .tracking-barcode { width: 48mm; height: 11mm; }
        .tracking { font-size: 10pt; font-weight: bold; }
    </style>
</head>
<body>
<div class="label">
    <table class="main">
        <tr><td class="header">한진택배　{{ print_date }}<span style="float:right;">운송장번호 {{ tracking_number }}</span></td></tr>
        <tr><td style="padding:0.3mm;">
            <table class="route"><tr>
                <td class="hub">{{ hub_code }}<br>{{ hub_number }}</td>
                <td style="width:23mm; text-align:center;">{% autoescape %}<img class="terminal-barcode" src="{{ terminal_barcode|raw }}" />{% endautoescape %}<br><span class="small">{{ terminal_code }}</span></td>
                <td><span class="sort">{{ center_code }}</span><span class="sub"> {{ middle_code }}</span><br><span class="small">{{ center_name }}　{{ terminal_name }}</span></td>
            </tr></table>
        </td></tr>
        <tr><td>
            <div class="small">받는 분　{{ receiver.phone }}</div>
            <div class="person">{{ receiver.name }}</div>
            <div class="address">{{ receiver.address }}</div>
            <div class="small">보내는 분　{{ sender.name }}　{{ sender.phone }}</div>
            <div class="address">{{ sender.address }}</div>
        </td></tr>
        <tr><td>
            <div class="small">상품명 / 배송 요청사항</div>
            <div class="item-name">{{ item_name }}　{{ item_quantity }}개</div>
            <div class="small">{{ delivery_request }}</div>
            <div class="small">운임 {{ freight_type }} {{ delivery_fee }}원　{{ region_name }}</div>
        </td></tr>
        <tr><td style="text-align:center; border-bottom:0;">
            <br><br><br><br>
            {% autoescape %}<img class="tracking-barcode" src="{{ tracking_barcode|raw }}" />{% endautoescape %}<br>
            <span class="tracking">{{ tracking_number }}</span><br>
            <span class="small">{{ worker_name }}　{{ worker_code }}　{{ order_number }}</span>
        </td></tr>
    </table>
</div>
</body>
</html>
