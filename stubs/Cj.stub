<html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <title>CJ Logistics 5-inch waybill</title>
        <style type="text/css">
            @page { margin: 0; }
            * { box-sizing: border-box; }
            body { margin: 0; padding: 0; font-family: nanumbarungothic, sans-serif; color: #000; }
            table { border-collapse: collapse; }
            .label { width: 123mm; height: 100mm; overflow: hidden; }
            .main { width: 123mm; height: 100mm; table-layout: fixed; }
            .main > tbody > tr > td { width: 123mm; padding: 0; vertical-align: top; }
            .section { border-bottom: 0.25mm solid #000; padding: 0.7mm 1.5mm; }
            .header { width: 100%; height: 7mm; table-layout: fixed; font-size: 7pt; }
            .header td { padding: 0 1mm; border: 0; white-space: nowrap; }
            .header .tracking { font-size: 9pt; font-weight: bold; }
            .header .date { text-align: center; }
            .header .count { text-align: center; }
            .header .service { text-align: right; }
            .routing { width: 100%; height: 19mm; table-layout: fixed; }
            .routing td { padding: 0.5mm; border: 0; vertical-align: middle; }
            .barcode { width: 34mm; height: 13mm; }
            .route-main { font-size: 23pt; font-weight: bold; white-space: nowrap; }
            .route-sub { font-size: 9pt; font-weight: bold; white-space: nowrap; }
            .diamond { font-size: 11pt; }
            .contact { width: 100%; table-layout: fixed; }
            .contact td { vertical-align: top; }
            .contact-label { width: 7mm; padding: 0.5mm 0; border-right: 0.25mm solid #000; text-align: center; font-size: 7pt; font-weight: bold; }
            .contact-data { padding: 0.8mm 1.5mm !important; }
            .recipient-name { font-size: 14pt; font-weight: bold; line-height: 1.1; }
            .recipient-address { font-size: 11pt; font-weight: bold; line-height: 1.15; }
            .small { font-size: 7pt; line-height: 1.15; }
            .fields { width: 100%; height: 7mm; table-layout: fixed; font-size: 7pt; }
            .fields td { padding: 0.5mm; border: 0.25mm solid #000; text-align: center; vertical-align: middle; }
            .items { font-size: 7pt; line-height: 1.15; }
            .footer-table { width: 100%; table-layout: fixed; }
            .footer-table td { padding: 0.5mm; border: 0; vertical-align: middle; }
            .footer-code { font-size: 10pt; font-weight: bold; white-space: nowrap; }
            .footer-barcode { width: 34mm; height: 9mm; }
            .privacy { font-size: 6pt; text-align: center; color: #900; }
        </style>
    </head>
    <body>
        <div class="label">
            <table class="main">
                <tr><td style="height:6mm;">
                    <table class="header">
                        <tr>
                            <td class="tracking">운송장번호 {{ tracking_number }}</td>
                            <td class="date">{{ print_date }}</td>
                            <td class="count">{{ total_printed_count }}</td>
                            <td class="service">택배이용문의 1588-1255</td>
                        </tr>
                    </table>
                </td></tr>
                <tr><td style="height:17mm;" class="section">
                    <table class="routing">
                        <tr>
                            <td style="width:37mm; text-align:center;">
                                {% autoescape %}<img class="barcode" src="{{ barcode|raw }}" />{% endautoescape %}<br>
                                <span class="small">{{ tracking_number }}</span>
                            </td>
                            <td style="width:65mm; text-align:center;">
                                <span class="route-main">{{ city.code }}</span>
                                <span class="route-sub">{{ region.code }}</span>
                                <span class="diamond">◆</span><br>
                                <span class="small">{{ city.name }} {{ region.name }}</span>
                            </td>
                            <td style="text-align:right; font-size:13pt; font-weight:bold;">P1</td>
                        </tr>
                    </table>
                </td></tr>
                <tr><td style="height:20mm;" class="section">
                    <table class="contact">
                        <tr>
                            <td class="contact-label">받<br>는<br>분</td>
                            <td class="contact-data">
                                <div class="small">{{ receiver.phone }} / {{ receiver.cell_phone }}</div>
                                <div class="recipient-name">{{ receiver.name }}</div>
                                <div class="recipient-address">{{ receiver.address }}</div>
                            </td>
                        </tr>
                    </table>
                </td></tr>
                <tr><td style="height:8mm;" class="section">
                    <table class="contact">
                        <tr>
                            <td class="contact-label">보<br>내<br>는<br>분</td>
                            <td class="contact-data">
                                <strong>{{ seller.name }}</strong>
                                <span class="small">{{ seller.phone }} / {{ seller.site }}</span><br>
                                <span class="small">{{ seller.address }}</span>
                            </td>
                        </tr>
                    </table>
                </td></tr>
                <tr><td style="height:6mm; padding:0;" class="section">
                    <table class="fields">
                        <tr>
                            <td>Box 수량<br>{{ box_quantity }}</td>
                            <td>운임Type<br>{{ freight_type }}</td>
                            <td>정산구분<br>{{ settlement_type }}</td>
                            <td>배송담당<br>{{ delivery_worker }}</td>
                        </tr>
                    </table>
                </td></tr>
                <tr><td style="height:13mm;" class="section">
                    <div class="small">상품정보</div>
                    <div class="items">{% for item in line_items %}{{ item }}<br>{% endfor %}</div>
                    <div class="small">주문번호: {{ site_order_no }}　출력일자: {{ printed }}</div>
                </td></tr>
                <tr><td style="height:6mm;" class="section">
                    <div class="privacy">개인정보 유출 우려가 있으니 운송장은 폐기 바랍니다.</div>
                </td></tr>
                <tr><td style="height:11mm; padding:0 1.5mm;">
                    <table class="footer-table">
                        <tr>
                            <td class="footer-code">CJ대한통운 - {{ region.code }}</td>
                            <td style="width:37mm; text-align:right;">
                                {% autoescape %}<img class="footer-barcode" src="{{ barcode|raw }}" />{% endautoescape %}<br>
                                <span class="small">{{ tracking_number }}</span>
                            </td>
                        </tr>
                    </table>
                </td></tr>
            </table>
        </div>
    </body>
</html>
